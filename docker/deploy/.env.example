# Robot configuration
LEADER_DOF=5
FOLLOWER_DOF=5

# Optional calibration paths, relative to the mounted /config/calibration directory
# Use container paths such as /config/calibration/5dof/leader_example_calibration.yaml
LEADER_CALIBRATION_FILE=
FOLLOWER_CALIBRATION_FILE=

# Serial ports
LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5C82106754-if00
FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5C82111146-if00

# Camera devices
FOLLOWER_FRONT_VIDEO_DEVICE=/dev/v4l/by-path/pci-0000:01:00.0-usb-0:2.1:1.0-video-index0
FOLLOWER_WRIST_VIDEO_DEVICE=/dev/v4l/by-path/pci-0000:01:00.0-usb-0:7:1.0-video-index0

# ROS 2 / DDS configuration
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=config/cyclonedds/cyclonedds.xml
