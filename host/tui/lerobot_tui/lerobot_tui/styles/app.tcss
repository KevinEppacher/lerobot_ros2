Screen {
    background: $surface;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1 2;
}

.section-title {
    height: 1;
    text-style: bold;
    color: $accent;
}

.dashboard-panel {
    height: auto;
    min-height: 4;
    margin-bottom: 1;
    padding: 0 1;
    border: round $primary;
}

#system-summary,
#docker-connection,
#robot-summary,
#service-summary {
    height: auto;
    padding-bottom: 0;
}

.dashboard-actions {
    height: auto;
    align: left middle;
}

DashboardView {
    height: 1fr;
}

#dashboard-logo,
#services-logo,
#robots-logo,
#wifi-logo,
#settings-logo {
    height: auto;
    width: 100%;
    padding: 0;
    margin-bottom: 0;
    overflow: hidden;
}

#dashboard-logo {
    margin-bottom: 1;
}

.placeholder-view {
    padding: 2 1;
}

ServicesView {
    height: 1fr;
}

ServicesView > #services-logo {
    margin-left: 1;
}

#category-filters {
    height: 1;
    align: left middle;
}

#category-filters Button {
    width: auto;
    min-width: 10;
    height: 1;
    border: none;
    margin-right: 1;
}

#service-table {
    height: 1fr;
    min-height: 4;
    border: round $primary;
}

#service-detail {
    height: 2;
    padding-left: 1;
}

#operation-feedback {
    height: 1;
}

#operation-status {
    height: 1;
    width: 1fr;
    color: $accent;
}

#operation-progress {
    height: 1;
    display: none;
}

#service-actions {
    height: 3;
}

#service-actions Button {
    width: auto;
    min-width: 8;
    height: 3;
    margin-right: 1;
}

#service-actions Button.-success:hover {
    color: #0a180e;
}

#service-actions Button:disabled {
    text-opacity: 0.8;
}

#view-error {
    width: auto;
    height: 3;
    display: none;
}

#service-help {
    height: 1;
    color: $text-muted;
}

ServiceLogsScreen,
OperationErrorScreen {
    padding: 1 2;
}

ServiceLogsScreen #service-logs,
#operation-error-details {
    height: 1fr;
    border: round $primary;
    padding: 1;
}

UpdateConfirmation {
    align: center middle;
}

ToolConfigurationScreen,
ToolExecutionConfirmation {
    align: center middle;
}

#tool-configuration,
#tool-confirmation {
    width: 72;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#tool-config-fields {
    height: auto;
    max-height: 65%;
}

#tool-config-error {
    height: auto;
    color: $error;
    display: none;
}

#tool-configuration Input,
#tool-configuration Select,
#tool-configuration Button,
#tool-confirmation Button {
    width: 1fr;
    margin-bottom: 1;
}

.tool-warning {
    color: $warning;
    margin-bottom: 1;
}

ToolOutputScreen {
    padding: 1 2;
}

#tool-output {
    height: 1fr;
    border: round $primary;
    padding: 1;
}

#update-confirmation {
    width: 70;
    height: auto;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

ServiceInfoScreen {
    align: center middle;
}

#service-information {
    width: 84;
    height: 90%;
    max-width: 96%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#service-information-content {
    height: 1fr;
    border: round $primary;
    padding: 1;
}
