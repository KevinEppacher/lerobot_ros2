<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101_5dof">
  <!-- Includes -->
  <xacro:include filename="$(find so101_description)/urdf/control/so101_5dof_ros2_control.xacro"/>
  <xacro:include filename="$(find so101_description)/urdf/utils/materials.xacro"/>
  <xacro:include filename="$(find so101_description)/urdf/links/gripper/follower/gripper_link.xacro"/>
  <xacro:include filename="so101_5dof_macro.xacro"/>
  <!-- Arguments -->
  <xacro:arg name="port" default="/dev/ttyACM0"/>
  <xacro:arg name="calibration_file" default="$(find so101_description)/config/follower_example_calibration.yaml"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="robot_plugin" default="hiwonder_lerobot_cpp/Follower"/>
  <!-- Instantiate macros -->
  <xacro:so101_5dof prefix="$(arg prefix)"/>
  <xacro:gripper
      prefix="$(arg prefix)"
      parent="tcp"
      xyz="0 0 0"
      rpy="0 0 0"/>
  <!-- Control macros -->
  <xacro:so101_ros2_control port="$(arg port)" calibration_file="$(arg calibration_file)" prefix="$(arg prefix)" robot_plugin="$(arg robot_plugin)"/>
</robot>
