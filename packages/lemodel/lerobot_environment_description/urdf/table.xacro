<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="table" params="prefix width depth thickness">
    <link name="${prefix}table_link">
      <visual>
        <geometry>
          <box size="${width} ${depth} ${thickness}"/>
        </geometry>
        <material name="table_gray">
          <color rgba="0.55 0.55 0.55 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${width} ${depth} ${thickness}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>
</robot>
