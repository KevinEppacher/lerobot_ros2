<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lerobot_workcell">

    <xacro:arg name="port" default="/dev/ttyACM0"/>

    <xacro:arg
        name="calibration_file"
        default="$(find so101_description)/config/leader_example_calibration.yaml"/>

    <xacro:arg
        name="robot_plugin"
        default="hiwonder_lerobot_cpp/Leader"/>

    <xacro:include
        filename="$(find lerobot_workcell_description)/urdf/workcell.urdf.xacro"/>

</robot>